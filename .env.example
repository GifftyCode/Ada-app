# ─────────────────────────────────────────────────────────
#  Ada — Environment Variables
#
#  1. Copy this file and rename the copy to exactly:  .env
#  2. Replace  your_api_key_here  with your real key
#  3. Get your key from: https://console.anthropic.com
#     → API Keys → Create Key → Copy it here
#
#  NEVER share this file or push it to GitHub.
#  The .gitignore already excludes .env for your safety.
# ─────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=your_api_key_here
